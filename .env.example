# OpenAI is used for embeddings and skill-gap generation.
OPENAI_API_KEY=sk-your-openai-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Pinecone is the online managed vector DB used by this project.
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX_NAME=job-skill-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=job-skill-set

# Optional bridge to feature 1. Point this at a joblib sklearn pipeline
# with a .predict([resume_text]) method that returns one of:
# HR, IT, Business-Dev, Finance, Sales.
RESUME_CLASSIFIER_PATH=
